
# Proveedor del LLM: anthropic (por defecto), google u ollama
LLM_PROVIDER=anthropic
# Opcional: cambia los modelos por defecto del proveedor
LLM_MODEL_FAST=
LLM_MODEL_SMART=

# Claves: solo hace falta la del proveedor que uses
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Calendario:google (tu Google Calendar).
CALENDAR_BACKEND=google

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# Langfuse 
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
